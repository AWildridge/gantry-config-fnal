### TURN ON ###

SETVAC etl_chuck_2 1
WAIT 1000
SETVAC etl_chuck_3 1
WAIT 1000
SETVAC etl_chuck_4 1
WAIT 1000

SETVAC etl_chuck_1_pos_1 1
WAIT 500
SETVAC etl_chuck_1_pos_2 1
WAIT 500
SETVAC etl_chuck_1_pos_3 1
WAIT 500
SETVAC etl_chuck_1_pos_4 1
WAIT 500
SETVAC etl_chuck_1_pos_5 1
WAIT 500
SETVAC etl_chuck_1_pos_6 1
WAIT 500
SETVAC etl_chuck_1_pos_7 1
WAIT 500
SETVAC etl_chuck_1_pos_8 1
WAIT 500
SETVAC etl_chuck_1_pos_9 1
WAIT 500
SETVAC etl_chuck_1_pos_10 1
WAIT 500
SETVAC etl_chuck_1_pos_11 1
WAIT 500
SETVAC etl_chuck_1_pos_12 1
WAIT 500
SETVAC etl_chuck_1_pos_13 1
WAIT 500
SETVAC etl_chuck_1_pos_14 1
WAIT 500
SETVAC etl_chuck_1_pos_15 1
WAIT 500
SETVAC etl_chuck_1_pos_16 1
WAIT 500

CHOICEPOPUP $c "Check vacuum gauge" "Turn off vacuums" "Exit"
GOTOIFN @EXIT $c

### TURN OFF ###

SETVAC etl_chuck_1_pos_1 0
WAIT 1000
SETVAC etl_chuck_1_pos_2 0
WAIT 1000
SETVAC etl_chuck_1_pos_3 0
WAIT 1000
SETVAC etl_chuck_1_pos_4 0
WAIT 1000
SETVAC etl_chuck_1_pos_5 0
WAIT 1000
SETVAC etl_chuck_1_pos_6 0
WAIT 1000
SETVAC etl_chuck_1_pos_7 0
WAIT 1000
SETVAC etl_chuck_1_pos_8 0
WAIT 1000
SETVAC etl_chuck_1_pos_9 0
WAIT 1000
SETVAC etl_chuck_1_pos_10 0
WAIT 1000
SETVAC etl_chuck_1_pos_11 0
WAIT 1000
SETVAC etl_chuck_1_pos_12 0
WAIT 1000
SETVAC etl_chuck_1_pos_13 0
WAIT 1000
SETVAC etl_chuck_1_pos_14 0
WAIT 1000
SETVAC etl_chuck_1_pos_15 0
WAIT 1000
SETVAC etl_chuck_1_pos_16 0
WAIT 1000

SETVAC etl_chuck_2 0
WAIT 1000
SETVAC etl_chuck_3 0
WAIT 1000
SETVAC etl_chuck_4 0

@EXIT
END